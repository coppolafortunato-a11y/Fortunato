# Copia questo file in ".env" e riempi i valori reali.
# NON committare mai ".env" (è già in .gitignore).
#
# La WP_APP_PASSWORD si genera da:
#   WordPress -> Utenti -> Profilo -> "Password applicazione"
#   nome: claude-code -> Aggiungi -> copia subito la stringa (non si rivede).
# A lavoro finito, revocala dallo stesso pannello.

WP_USER=fortunato
WP_APP_PASSWORD="abcd EFGH ijkl MNOP qrst UVWX"
WP_BASE=https://ideamkt.it

# --- Facoltativo: upload FTP del mu-plugin (Obiettivo 2) ---
# Se non li imposti, carica ideamkt-extras.php a mano da cPanel -> Gestione file.
FTP_HOST=
FTP_USER=
FTP_PASS=

# --- Meta (Facebook/Instagram) per scripts/meta.py ---
# Il token si genera dal tuo browser: vedi scripts/meta-setup.md.
# FB_PAGE_ID e FB_AD_ACCOUNT sono facoltativi (l'app li ricava se ce n'è uno solo).
META_TOKEN=
FB_PAGE_ID=
FB_AD_ACCOUNT=
