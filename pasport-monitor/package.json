{
  "name": "pasport-monitor",
  "version": "1.0.0",
  "description": "Monitor disponibilita appuntamenti Passaportny servis DP Dokument (5 centri)",
  "main": "src/monitor.js",
  "scripts": {
    "start": "node src/monitor.js",
    "check": "node src/check.js",
    "baseline": "node src/check.js --no-notify",
    "inspect": "node src/inspect.js",
    "chat-id": "node src/test-notifiche.js --chat-id",
    "test": "node test/run-tests.js && node test/test-rotation.js && node test/test-whatsapp-state.js",
    "install-service": "bash install/install.sh",
    "setup": "node src/setup.js",
    "whatsapp-login": "node src/whatsapp-login.js",
    "test-notifiche": "node src/test-notifiche.js",
    "whatsapp-verifica": "node src/whatsapp-verifica.js",
    "chrome-collegabile": "powershell -ExecutionPolicy Bypass -File install/crea-scorciatoia-chrome.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "nodemailer": "^10.0.10",
    "playwright": "^1.56.1"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  }
}
