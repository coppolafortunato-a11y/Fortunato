# ---- TELEGRAM (canale consigliato) ----
# 1. Su Telegram apri @BotFather -> /newbot -> scegli nome -> ricevi il token
# 2. Scrivi /start al tuo nuovo bot
# 3. Lancia: npm run chat-id   -> copia il numero qui sotto
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- EMAIL ----
# Con Gmail: SMTP_PASS non e' la password normale, ma una "password per le
# app" (Account Google -> Sicurezza -> Verifica in due passaggi -> Password
# per le app). Piu' destinatari separati da virgola.
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=

# ---- WHATSAPP ----
# Usa WhatsApp Web gia' collegato su questo computer.
# Collegalo una volta sola con:  npm run whatsapp-login
# Poi elenca qui i destinatari, formato  Nome:+39numero
# Esempio: WHATSAPP_RECIPIENTS=Daria:+393331112222,Ulina:+393334445555
WHATSAPP_RECIPIENTS=

# ---- COMPORTAMENTO ----
# Un ciclo ogni quanti minuti. Con la rotazione attiva viene controllato
# UN solo centro per ciclo: con 5 centri, ognuno viene visto ogni 75 minuti.
INTERVAL_MINUTES=15

# Rotazione: indispensabile. Il sito risponde 403 dopo poche richieste
# ravvicinate, quindi non si controllano mai i 5 siti in sequenza.
ROTATE=true
CENTERS_PER_CYCLE=1

# Centri da controllare. Predefinito: i quattro in Polonia.
# Con 4 centri e un ciclo ogni 15 minuti, ognuno viene visto ogni ora.
# Per aggiungere Milano:  ONLY_CENTERS=krakow,warszawa,wroclaw,gdansk,milan
# Per controllarli tutti, lascia vuoto.
ONLY_CENTERS=krakow,warszawa,wroclaw,gdansk

# Dopo un blocco il centro riposa 2, 4, 8... cicli, fino a questo massimo.
BACKOFF_MAX_CYCLES=16
DURATION_DAYS=10
PRIORITY_BEFORE=2026-10-15
ERROR_ALERT_THRESHOLD=3
NAV_TIMEOUT_MS=60000
# HEADLESS=false per vedere il browser durante il debug
HEADLESS=true
